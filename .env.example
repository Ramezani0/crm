# Public site URL (Docker / VPS). Not a secret.
NODE_ENV=production
PORT=3000
APP_URL=https://www.fasihicrm.ir

# Browser API base. Empty = same-origin /api/* (Caddy on the VPS).
# When unset/unreachable, the store falls back to demo CRM data (no crash).
VITE_API_BASE_URL=

# Optional Phase 1 demo password. Do not commit a real value.
# If unset, any non-empty password is accepted for named demo usernames.
VITE_DEMO_PASSWORD=

# Optional public Iran Payamak API host for UI labels only (not a secret).
VITE_IRANPAYAMAK_BASE_URL=

# --- Iran Payamak — server env only (vps/app.py / vps/sms.py). Never prefix with VITE_. Do not commit values. ---
# Send is configured when a line number is set AND (API key OR username+password).
IRANPAYAMAK_API_BASE=https://api.iranpayamak.com
IRANPAYAMAK_API_KEY=
IRANPAYAMAK_USERNAME=
IRANPAYAMAK_PASSWORD=
IRANPAYAMAK_LINE=
IRANPAYAMAK_LINE_NUMBER=
LINE_NUMBER=

# SMS dry-run (default 1 until Amir confirms live send). When 1, send logs intent and does not hit live API.
SMS_DRY_RUN=1

# Optional path for SMS JSON store (tasks/inbox/panel settings). Default: vps/sms-store.json
# FASIHI_SMS_STORE=

# Optional admin token for destructive-ish ops (backfill apply). Never commit a real value.
ADMIN_TOKEN=
FASIHI_ADMIN_TOKEN=

# --- BimeBazar premium compare (server-side) ---
# Never commit real values. On the box, load from /home/box/.secrets/bimebazar.env.
# Do NOT prefix secrets with VITE_ (they must not ship to the browser).
BIMEBAZAR_URL=
BIMEBAZAR_USER=
BIMEBAZAR_PASS=
# Optional overrides (defaults: shoraka.net login + iframe.shoraka.net API)
BIMEBAZAR_LOGIN_BASE=
BIMEBAZAR_API_BASE=
# Browser: auto = live when /api/premium-compare/status.configured; mock = explicit demo only.
VITE_PREMIUM_COMPARE_SOURCE=auto

# Sanhab vehicle inquiry source (server-side). Default live = BimeBazar partners.
# DEMO only when explicitly set to demo (or request body demo:true). Never invent official Sanhab creds.
# SANHAB_VEHICLE_SOURCE=live
# SANHAB_VEHICLE_SOURCE=demo

# --- Premium AI advisor (Gemini on VPS — server-side only) ---
# Never commit real values. On the box: /home/box/.secrets/premium-ai.env
# Do NOT prefix secrets with VITE_ (must not ship to the browser).
# Model id from env. Live ops LOCK primary to gemini-3.8-flash.
# If primary returns 403/404/503/timeout, optional FALLBACK is tried once (503 may retry once).
# Recommend: PREMIUM_AI_MODEL_FALLBACK=gemini-flash-latest
PREMIUM_AI_PROVIDER=gemini
PREMIUM_AI_BASE_URL=https://generativelanguage.googleapis.com/v1beta
PREMIUM_AI_MODEL=gemini-3.8-flash
PREMIUM_AI_MODEL_FALLBACK=gemini-flash-latest
PREMIUM_AI_API_VERSION=v1beta
PREMIUM_AI_API_KEY=
PREMIUM_AI_AUTH_STYLE=query_key
# Per-attempt Gemini timeout seconds (default 8, clamp 3–20). Keeps chat JSON under ~15s wall.
PREMIUM_AI_TIMEOUT_SEC=8

# --- Sima Zar gold rate (server-side live tgju) ---
# Source: tgju (default) | manual | demo
# Live = طلای ۲۴ عیار آنی (ریال/گرم) via public JSON — no secrets.
SIMA_ZAR_RATE_SOURCE=tgju
SIMA_ZAR_RATE_URL=https://call1.tgju.org/ajax.json
SIMA_ZAR_RATE_KEY=geram24
SIMA_ZAR_RATE_TIMEOUT_SEC=8
SIMA_ZAR_RATE_CACHE_SEC=60
SIMA_ZAR_SYMBOL=GOB1CD0001
# Optional fallback seed only (not silent primary when source=tgju):
# SIMA_ZAR_RATE_RIAL_PER_GRAM=

# --- Omid / امید بازنشستگی — Teamsho public deep-link (not a secret) ---
# Default in code: https://teamsho.karafarin-insurance.ir/
# Deep-link only (new tab). No iframe. No server scrape/proxy.
# Browser override (Vite injects VITE_* only):
VITE_OMID_TEAMSHO_URL=
# Docs/ops alias (same public URL; unused by Vite unless mirrored as VITE_):
# OMID_TEAMSHO_URL=https://teamsho.karafarin-insurance.ir/
